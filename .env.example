# ── Required ──────────────────────────────────────────────────────────────────

# Your EVM private key (0x-prefixed)
# Used to sign Hyperliquid trades AND pay for signal fetches via x402
# This key NEVER leaves your machine.
AGENT_PRIVATE_KEY=0x...

# AgentSignal base URL — leave as-is unless self-hosting
AGENT_SIGNAL_URL=https://agentsignal.app

# ── Optional ──────────────────────────────────────────────────────────────────

# Default position size in USD (used if not set per-strategy in Navigator)
HL_POSITION_SIZE_USD=10

# Dashboard port (default: 4100)
# DASHBOARD_PORT=4100
